{
  "name": "axe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix extension install",
    "install:video": "npm --prefix video install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:video": "npm --prefix video run dev",
    "build:backend": "npm --prefix backend run build",
    "build:extension": "npm run build:extension:production",
    "build:extension:local": "npm --prefix extension run build:local",
    "build:extension:production": "npm --prefix extension run build:production",
    "build": "npm run build:backend && npm run build:extension",
    "render:video": "npm --prefix video run render"
  }
}
